# WooCommerce store base URL (no trailing slash)
WC_STORE_URL=http://127.0.0.1:8787

# API-key auth (WooCommerce REST API consumer credentials)
# Leave empty when using the connect OAuth/app-auth flow, which writes .credentials.json
WC_CONSUMER_KEY=ck_demo_key
WC_CONSUMER_SECRET=cs_demo_secret

# Auth strategy: auto | basic | query | oauth1
# auto: HTTPS uses Basic Auth; HTTP uses OAuth 1.0a one-legged
WC_AUTH_MODE=auto

# Client-side rate limit (WooCommerce REST API has no global SLA; hosts still throttle)
WC_RATE_LIMIT_RPS=5
WC_MAX_RETRIES=4
WC_MAX_CONCURRENCY=3

# Redact emails/phones in MCP tool output (keep true for logs; set false only in a private merchant tenancy)
WC_REDACT_PII=false
